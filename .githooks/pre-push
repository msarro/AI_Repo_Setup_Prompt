#!/bin/sh
# Refuses pushes to main and runs the local checks before anything leaves this computer.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are not allowed. Push a branch and open a pull request." >&2
    exit 1
  fi
done
here=$(git rev-parse --show-toplevel)
sh "$here/scripts/test-check-prompt.sh" && sh "$here/scripts/check-prompt.sh" &&
  gitleaks git --redact --no-banner "$here"
